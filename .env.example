# Banco de dados (PostgreSQL único)
DATABASE_URL="postgresql://user:password@localhost:5432/carflow_db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Opcional - WhatsApp via Evolution API
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# OpenWeather API (previsão do tempo)
OPENWEATHER_API_KEY="your-openweather-api-key"
OPENWEATHER_LAT="-23.5505"
OPENWEATHER_LON="-46.6333"

# Plate Recognizer (OCR de placas) - gratis ate 2500/mes
# https://platerecognizer.com
PLATE_RECOGNIZER_API_KEY="seu-token-aqui"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CarFlow ERP"

# Instagram (link no QR code de feedback)
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/seu_perfil"
